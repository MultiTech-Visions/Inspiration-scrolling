# Required: MySQL connection. Use either CLOUD_SQL_CONNECTION_NAME (production
# on Cloud Run, Unix socket) OR MYSQL_HOST/MYSQL_PORT (local dev). Failing to
# set either group raises a loud error at boot — there are no host defaults.
CLOUD_SQL_CONNECTION_NAME=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Required: Anthropic API key for the LLM pipeline.
ANTHROPIC_API_KEY=

# GitHub Personal Access Token. Recommended: fine-grained PAT, read-only,
# scoped to the repos you want codebase audits on, with these permissions:
#   - Metadata: Read-only        (always required by GitHub)
#   - Contents: Read-only        (README, manifests)
#   - Pull requests: Read-only   (the codebase agent reads PRs and patches)
#   - Issues: Read-only          (open issues are a primary signal)
# Without a token, the app falls back to the unauthenticated public REST API,
# which is fine for public-repo activity ingestion but severely rate-limited
# and blocks all access to private repos.
GITHUB_TOKEN=

# Cloud Run port. Functions-framework reads this automatically.
PORT=8080
