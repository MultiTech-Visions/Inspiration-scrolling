# Required: MySQL connection. Use either CLOUD_SQL_CONNECTION_NAME (production
# on Cloud Run, Unix socket) OR MYSQL_HOST/MYSQL_PORT (local dev). Failing to
# set either group raises a loud error at boot — there are no host defaults.
CLOUD_SQL_CONNECTION_NAME=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Required: Anthropic API key for the LLM pipeline.
ANTHROPIC_API_KEY=

# Optional: GitHub Personal Access Token. Without it, activity ingestion uses
# the public, unauthenticated GitHub Events API with a tight rate limit.
GITHUB_TOKEN=

# Cloud Run port. Functions-framework reads this automatically.
PORT=8080
